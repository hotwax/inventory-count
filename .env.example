# Default: OFBIZ. Possible values: OFBIZ, MOQUI
VITE_OMS_TYPE=
VITE_I18N_LOCALE=en-US
VITE_I18N_FALLBACK_LOCALE=en-US
VITE_CACHE_MAX_AGE=3600
VITE_VIEW_SIZE=20
# Max facet options fetched from admin/solrFacets for the create count filters
VITE_MAX_FACETS=5000
# Max products that can be selected into a single cycle count
VITE_MAX_COUNT_ITEMS=2000
VITE_APP_PERMISSION_ID="INVCOUNT_APP_VIEW"
# Multi-version app hosting config (single JSON object). buildVersion: "" = root bootstrap, "vX.Y.Z" = versioned build.
VITE_APP_VERSION_CONFIG={"appId":"CYCLE_COUNT","environmentTypeId":"AppEnvDev","buildVersion":""}
VITE_DEFAULT_LOG_LEVEL="error"
VITE_PRDT_IDENT=["productId", "groupId", "groupName", "internalName", "parentProductName", "primaryProductCategoryName", "title"]
VITE_MAPPING_TYPES={"INVCOUNT": "INVCNT_MAPPING_PREF"}
VITE_MAPPING_INVCOUNT={"countImportName": { "label": "Count name", "required": true}, "purposeType": {"label": "Count Type", "required": false, "description": "Defaults to 'DIRECTED_COUNT'"},  "productSku": { "label": "Product SKU", "required": true, "description": "Products will not be deduplicated. Make sure products are only added to a count once."},"facility": { "label": "Facility ID", "required": false, "description": "Internal Facility ID, If a file includes multiple facilities, a count is created for every facility. All items with no facility location will be added to the same count." }, "externalFacility": { "label": "External Facility ID", "required": false, "description": "If a file includes multiple facilities, a count is created for every facility. All items with no facility location will be added to the same count." }, "estimatedCompletionDate": { "label": "Due date", "description": "Format: MM-dd-yyyy HH:mm:ss Ex: 12-31-2023 23:59:59", "required": false }, "estimatedStartDate": { "label": "Start date", "description": "Format: MM-dd-yyyy HH:mm:ss Ex: 12-31-2023 23:59:59", "required": false }}
VITE_DOWNLOAD_MAPPING_ID="INV_REPORT_PREF"
VITE_LOGIN_URL="http://launchpad.hotwax.io/login"
VITE_SHOPIFY_API_KEY=
VITE_SHOPIFY_REDIRECT_URI=
VITE_SHOPIFY_SHOP_CONFIG={"shop1.myshopify.com":  { "apiKey": "<Client ID>", "maarg": "<Maarg Instance URL>" }}


# Playwright E2E Automation Variables
ADMIN_USERNAME=your_admin_username_here
ADMIN_PASSWORD=your_admin_password_here

STORE_USER_USERNAME=your_store_user_username_here
STORE_USER_PASSWORD=your_store_user_password_here

OMS_NAME=mersea-oms
MERSEA_UAT_URL=https://inventorycount-uat.hotwax.io/login
MERSEA_PROD_URL=https://inventorycount.hotwax.io/bulkUpload
